# =============================================================================
# Plantilla de variables de entorno — Anim3D (instancia por club)
# =============================================================================
# Copiar este archivo como `.env` en el directorio del backend y rellenar.
# El script `deploy/nuevo_club.sh` lo genera automáticamente sustituyendo
# __CLUB__ y __FLASK_PORT__ por los valores reales.
# =============================================================================

# ── Base de datos MySQL ──
DB_HOST=localhost
DB_USER=anim3d
DB_PASSWORD=                                  # ← OBLIGATORIO, rellenar
DB_NAME=bd_anim3d___CLUB__

# ── Puerto interno de Flask (proxied por nginx) ──
SALTO_PORT=__FLASK_PORT__

# ── CORS ──
# Dominio raíz a partir del cual se aceptan subdominios (regex en app.py).
# Ejemplo: tacticalcore.es → acepta https://*.tacticalcore.es
CORS_DOMAIN=tacticalcore.es

# Para entornos de desarrollo, también se acepta http://localhost:* automáticamente.
# Para forzar lista exacta en lugar del regex, definir CORS_ORIGINS (separado por comas):
# CORS_ORIGINS=https://__CLUB__.tacticalcore.es

# ── Subida de vídeos ──
MAX_UPLOAD_MB=100
