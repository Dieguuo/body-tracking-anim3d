# =============================================================================
# Plantilla nginx — Instancia Anim3D por club
# =============================================================================
# Uso:
#   Sustituir los placeholders __CLUB__, __FLASK_PORT__, __WEBROOT__,
#   __SSL_CERT__ y __SSL_KEY__ con los valores reales del club.
#
#   El script `deploy/nuevo_club.sh` automatiza esta sustitución.
#
# Ubicación final típica:
#   /etc/nginx/sites-available/__CLUB__.conf
#   /etc/nginx/sites-enabled/__CLUB__.conf  (symlink)
# =============================================================================

# ─── Redirección HTTP → HTTPS ───────────────────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name __CLUB__.tacticalcore.es;

    # Permitir validación ACME (Let's Encrypt) sin forzar redirect
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ─── Servidor HTTPS principal ───────────────────────────────────────────────
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __CLUB__.tacticalcore.es;

    # ── SSL (wildcard *.tacticalcore.es recomendado) ──
    ssl_certificate     __SSL_CERT__;
    ssl_certificate_key __SSL_KEY__;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # ── Cabeceras de seguridad ──
    # CSP: permitir embebido en cualquier subdominio de tacticalcore.es
    add_header Content-Security-Policy "frame-ancestors https://*.tacticalcore.es https://tacticalcore.es" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Nota: NO se añade X-Frame-Options (obsoleto y entra en conflicto con frame-ancestors).

    # ── Tamaño máximo de subida (vídeos de salto hasta 100 MB) ──
    client_max_body_size 100m;

    # ── Frontend estático ──
    root __WEBROOT__;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # ── Proxy inverso al backend Flask ──
    location /api/ {
        proxy_pass http://127.0.0.1:__FLASK_PORT__/api/;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        # Timeouts generosos para procesamiento de vídeo con MediaPipe
        proxy_connect_timeout 60s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;
        send_timeout          300s;

        # Permitir streaming de respuestas de vídeo (rangos HTTP 206) sin buffer.
        # Mantenemos proxy_request_buffering ON (default) para que werkzeug reciba
        # el body completo de las subidas POST de vídeo (hasta 100 MB).
        proxy_buffering off;
    }

    # ── Logs por club ──
    access_log /var/log/nginx/__CLUB__.access.log;
    error_log  /var/log/nginx/__CLUB__.error.log;
}
